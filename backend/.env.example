# Copy to backend/.env (or run ./setup_auth_env.sh to create it automatically).
COLLAB_JWT_SECRET=change-me-to-a-long-random-string-matching-collab
COLLAB_JWT_ISSUER=opendraft-collab
COLLAB_JWT_AUDIENCE=opendraft-backend
COLLAB_DB_PATH=/absolute/path/to/collab-server/data/collab.sqlite3
COLLAB_SERVER_URL=http://localhost:4000
FREE_PLAN_FILE_LIMIT=5
# DEMO_MODE=1

# Optional remote for manual hosted-backend checkpoints. HTTPS is the default;
# use the insecure-HTTP opt-in only for an isolated, trusted local transport.
# OPENDRAFT_GIT_BACKUP_ENABLED=true
# OPENDRAFT_GIT_BACKUP_URL=https://gitea.example.com/film/opendraft-backups.git
# OPENDRAFT_GIT_BACKUP_ALLOW_INSECURE_HTTP=false
# OPENDRAFT_GIT_BACKUP_USERNAME=opendraft-backup
# OPENDRAFT_GIT_BACKUP_TOKEN_FILE=/absolute/path/to/gitea-token
# OPENDRAFT_GIT_BACKUP_REF_PREFIX=opendraft
# OPENDRAFT_GIT_BACKUP_CA_BUNDLE=/absolute/path/to/combined-ca-bundle.pem
