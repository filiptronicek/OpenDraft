# Template for deploy/combined.env — copy and fill in. The real file is gitignored.
#   cp deploy/combined.env.example deploy/combined.env
#   docker run --env-file deploy/combined.env -p 18080:8080 -p 18081:8081 opendraft-combined

# REQUIRED — secret used to sign JWT access/refresh tokens.
JWT_SECRET=change-me
JWT_ISSUER=opendraft-collab
JWT_AUDIENCE=opendraft-backend

# Disable after creating the accounts needed by a private deployment.
LOCAL_REGISTRATION_ENABLED=true

# OPTIONAL — SMTP credentials for transactional email (verification, password
# reset). Without SMTP, new accounts are auto-verified and password-reset
# email is unavailable.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# OPTIONAL — seed a single demo user on first boot. Idempotent: skipped if the
# email already exists. Leave SEED_DEMO_USER unset to disable.
SEED_DEMO_USER=false
SEED_DEMO_USER_EMAIL=demo@opendraft.local
SEED_DEMO_USER_PASSWORD=
SEED_DEMO_USER_NAME=Demo User

# OPTIONAL — remote Git backup for manual project checkpoints. Mount the token:
#   --mount type=bind,src=/host/gitea-token,dst=/run/secrets/opendraft_gitea_token,ro
# OPENDRAFT_GIT_BACKUP_ENABLED=true
# OPENDRAFT_GIT_BACKUP_URL=https://gitea.example.com/film/opendraft-backups.git
# Set true only after verifying the remote transport stays on a trusted host.
# OPENDRAFT_GIT_BACKUP_ALLOW_INSECURE_HTTP=false
# OPENDRAFT_GIT_BACKUP_USERNAME=opendraft-backup
# OPENDRAFT_GIT_BACKUP_TOKEN_FILE=/run/secrets/opendraft_gitea_token
# OPENDRAFT_GIT_BACKUP_REF_PREFIX=opendraft
# For a private CA, also bind-mount a full CA bundle and set its container path:
# OPENDRAFT_GIT_BACKUP_CA_BUNDLE=/run/secrets/opendraft_gitea_ca_bundle
