# ── DuckDNS subdomains (or any domain pointed at this VPS's public IP) ──
DEMO_HOST=opendraft.duckdns.org
COLLAB_HOST=opendraft-collab.duckdns.org

# Email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.com

# Collab server secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-hex-string
# JWT contract shared by the backend and collaboration service.
JWT_ISSUER=opendraft-collab
JWT_AUDIENCE=opendraft-backend

# Leave true for initial account creation, then set false on a private instance.
LOCAL_REGISTRATION_ENABLED=true

# CORS origins the collab server will accept (comma-separated, no spaces)
CORS_ORIGINS=https://opendraft.duckdns.org,http://localhost:5173,tauri://localhost,https://tauri.localhost

# ─────────────────────────────────────────────────────────────────────────────
# Combined-image mode only (./deploy.sh --combined). Ignored by the default
# source-build mode. Publish Dockerfile.combined from this fork to a container
# registry, then set its registry/repository without a tag. Combined mode fails
# closed when this value is absent so it cannot silently run the public upstream
# image, which does not contain this fork's auth and backup changes.
# OPENDRAFT_IMAGE=registry.example.com/film/opendraft-combined
# Pin an image tag for predictable rollbacks.
# OPENDRAFT_VERSION=0.23.1-hardened.1

# Optional SMTP for transactional email (verification links). Leave SMTP_HOST
# unset and the collab server auto-verifies new sign-ups instead.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Optional one-time demo user seeded on first boot. Idempotent — existing
# users are not touched. Leave SEED_DEMO_USER unset to disable.
# SEED_DEMO_USER=true
# SEED_DEMO_USER_EMAIL=demo@opendraft.local
# SEED_DEMO_USER_PASSWORD=
# SEED_DEMO_USER_NAME=Demo User

# Optional: mirror manual File -> Versions -> Check In checkpoints into one
# pre-created private Gitea repository. Each project gets an isolated branch.
# The token needs repository write access, but no Gitea admin/API scope.
# OPENDRAFT_GIT_BACKUP_ENABLED=true
# OPENDRAFT_GIT_BACKUP_URL=https://gitea.example.com/film/opendraft-backups.git
# Set true only after verifying the remote transport stays on a trusted host.
# OPENDRAFT_GIT_BACKUP_ALLOW_INSECURE_HTTP=false
# OPENDRAFT_GIT_BACKUP_USERNAME=opendraft-backup
# OPENDRAFT_GIT_BACKUP_TOKEN_HOST_FILE=/absolute/path/to/gitea-token
# OPENDRAFT_GIT_BACKUP_REF_PREFIX=opendraft
# For Gitea TLS signed by a private CA, provide a full CA bundle on the host:
# OPENDRAFT_GIT_BACKUP_CA_BUNDLE_HOST_FILE=/absolute/path/to/ca-bundle.pem
