# Copy to collab-server/.env (or run ./setup_auth_env.sh to create it automatically).
# Must match backend's COLLAB_JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string-matching-backend
APP_URL=http://localhost:5173
LOCAL_LOGIN_ENABLED=true
LOCAL_REGISTRATION_ENABLED=true
# Configure every required OIDC setting together. In production APP_URL,
# OIDC_ISSUER_URL, and OIDC_REDIRECT_URI must use HTTPS.
# OIDC_ISSUER_URL=https://auth.example.com/application/o/opendraft/
# OIDC_CLIENT_ID=opendraft
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# OIDC_REDIRECT_URI=https://scripts.example.com/api/auth/oidc/callback
# OIDC_DISPLAY_NAME=Authentik
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@opendraft.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
